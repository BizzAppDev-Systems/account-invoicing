<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit the res.config.settings form view to add the invoice mode field. -->
    <record
        id="res_config_settings_form_view_inherit_account_invoice_google_document_ai_single_line"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.form.inherit.account.invoice.google.document.ai.single.line</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="account_invoice_google_document_ai.res_config_settings_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='account_ocr_google_settings']" position="after">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    id="account_google_ocr_invoice_mode"
                >
                    <div
                        class="o_setting_right_pane"
                        id="account_ocr_google_settings_right_google_ocr_invoice_mode"
                    >
                        <span class="o_form_label">Google OCR Invoice Mode</span>
                        <div class="text-muted">
                            Configures how Google Invoice OCR processes and extracts invoice data.
                        </div>
                        <div class="row mt16">
                            <field
                                name="google_ocr_invoice_mode"
                                class="col-lg-9 o_field_widget o_field_many2one"
                            />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
